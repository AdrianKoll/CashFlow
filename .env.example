# Ambiente: development ou production
CASHFLOW_ENV=development

# Gere um valor forte e exclusivo para cada ambiente.
CASHFLOW_SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
CASHFLOW_DATABASE_URI=sqlite:///cashflow_dados.sqlite3

# Criação opcional do primeiro administrador.
# Remova estas variáveis depois do primeiro acesso se não forem mais necessárias.
CASHFLOW_ADMIN_NAME=Administrador
CASHFLOW_ADMIN_USERNAME=troque-o-usuario
CASHFLOW_ADMIN_PASSWORD=troque-por-uma-senha-com-pelo-menos-12-caracteres

# Execução local segura por padrão.
CASHFLOW_HOST=127.0.0.1
CASHFLOW_PORT=5000
CASHFLOW_DEBUG=false
CASHFLOW_SESSION_COOKIE_SECURE=false

# Limite de tentativas de login (5 por usuário e 10 por IP a cada 15 minutos).
# Por padrão os contadores ficam em memória (um por processo). Com vários
# workers do Gunicorn, use um armazenamento compartilhado, como Redis
# (exige instalar o pacote "redis"), por exemplo: redis://localhost:6379
CASHFLOW_RATELIMIT_STORAGE_URI=memory://

# Número de proxies reversos confiáveis na frente da aplicação (Nginx, etc.).
# Deixe 0 se a aplicação recebe conexões diretas: o cabeçalho X-Forwarded-For
# pode ser forjado por qualquer cliente e seria usado para fugir do limite.
CASHFLOW_TRUSTED_PROXIES=0

# --- Docker Compose (docker compose up --build) ---
# Senha do PostgreSQL do container. No Compose, a CASHFLOW_DATABASE_URI é
# montada automaticamente a partir dela (o valor acima é ignorado).
# Evite os caracteres @ : / ? # % na senha, pois ela vai dentro de uma URL.
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-banco
