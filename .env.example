# Ambiente: development ou production
CASHFLOW_ENV=development

# Gere um valor forte e exclusivo para cada ambiente.
CASHFLOW_SECRET_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
CASHFLOW_DATABASE_URI=sqlite:///cashflow_dados.sqlite3

# Criação opcional do primeiro administrador.
# Remova estas variáveis depois do primeiro acesso se não forem mais necessárias.
CASHFLOW_ADMIN_NAME=Administrador
CASHFLOW_ADMIN_USERNAME=troque-o-usuario
CASHFLOW_ADMIN_PASSWORD=troque-por-uma-senha-com-pelo-menos-12-caracteres

# Execução local segura por padrão.
CASHFLOW_HOST=127.0.0.1
CASHFLOW_PORT=5000
CASHFLOW_DEBUG=false
CASHFLOW_SESSION_COOKIE_SECURE=false
